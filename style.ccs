:root {
  --bg-color: #0D0D0D;
  --surface-color: #171717;
  --surface-border: #2A2415;
  --primary-gold: #D4AF37;
  --gold-glow: rgba(212, 175, 55, 0.25);
  --text-main: #FFFFFF;
  --text-muted: #A3A3A3;
  --accent-green: #22C55E;
  --accent-red: #EF4444;
  --card-bg: linear-gradient(145deg, #1A1A1A, #121212);
  --header-bg: rgba(13, 13, 13, 0.85);
}

[data-theme="light"] {
  --bg-color: #F8F9FA;
  --surface-color: #FFFFFF;
  --surface-border: #E5E0D0;
  --primary-gold: #B8860B;
  --gold-glow: rgba(184, 134, 11, 0.18);
  --text-main: #1A1A1A;
  --text-muted: #6B7280;
  --card-bg: linear-gradient(145deg, #FFFFFF, #F3F0E6);
  --header-bg: rgba(248, 249, 250, 0.9);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  -webkit-tap-highlight-color: transparent;
}

body {
  background-color: var(--bg-color);
  color: var(--text-main);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow-x: hidden;
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* Smartphone Container Frame */
.app-container {
  width: 100%;
  max-width: 430px;
  min-height: 100vh;
  height: 100vh;
  position: relative;
  background-color: var(--bg-color);
  box-shadow: 0 0 35px var(--gold-glow);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Screen Switcher System */
.screen {
  display: none;
  flex-direction: column;
  height: 100%;
  width: 100%;
  overflow-y: auto;
  padding-bottom: 85px;
}

.screen.active {
  display: flex;
  animation: fadeIn 0.25s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

/* 1. Flash / Splash Screen */
#splash_screen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at center, #1F1908 0%, #0D0D0D 80%);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 24px;
}

#splash_screen.fade-out {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.6s ease;
}

.splash-icon {
  width: 100px;
  height: 100px;
  margin-bottom: 24px;
  filter: drop-shadow(0 0 16px var(--primary-gold));
  animation: pulse 2s infinite ease-in-out;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.splash-title {
  color: var(--primary-gold);
  font-size: 26px;
  font-weight: 800;
  letter-spacing: 3px;
  margin-bottom: 8px;
}

.splash-subtitle {
  color: var(--text-main);
  font-size: 15px;
  font-weight: 500;
  margin-bottom: 6px;
}

.splash-desc {
  color: var(--text-muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 30px;
}

.pagination {
  display: flex;
  gap: 8px;
  margin-top: 15px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: #333333;
}

.dot.active {
  width: 26px;
  border-radius: 6px;
  background-color: var(--primary-gold);
}

/* Header & Top Bar */
.top-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 20px;
  position: sticky;
  top: 0;
  background-color: var(--header-bg);
  backdrop-filter: blur(10px);
  z-index: 10;
  border-bottom: 1px solid var(--surface-border);
}

.app-brand {
  font-size: 20px;
  font-weight: 700;
  color: var(--primary-gold);
  letter-spacing: 1px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-icon {
  background: var(--surface-color);
  border: 1px solid var(--surface-border);
  color: var(--primary-gold);
  border-radius: 50%;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 16px;
}

/* Profit Card */
.profit-card {
  margin: 16px 20px;
  padding: 22px;
  background: var(--card-bg);
  border: 1px solid var(--surface-border);
  border-radius: 18px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  position: relative;
  overflow: hidden;
}

.profit-card::after {
  content: "";
  position: absolute;
  top: -50%;
  right: -50%;
  width: 120px;
  height: 120px;
  background: var(--primary-gold);
  filter: blur(55px);
  opacity: 0.18;
}

.profit-label {
  font-size: 13px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.profit-amount-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 10px;
}

.profit-amount {
  font-size: 30px;
  font-weight: 800;
  color: var(--text-main);
}

.badge-growth {
  background: rgba(34, 197, 94, 0.15);
  color: var(--accent-green);
  font-size: 13px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  border: 1px solid rgba(34, 197, 94, 0.3);
}

/* Action Buttons */
.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  padding: 0 20px;
  margin-bottom: 22px;
}

.btn-gold-action {
  background: linear-gradient(135deg, var(--primary-gold), #967417);
  border: none;
  border-radius: 14px;
  padding: 16px;
  color: #000;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: 0 6px 16px var(--gold-glow);
  transition: transform 0.15s ease;
}

.btn-gold-action:active {
  transform: scale(0.97);
}

/* Transaction List */
.section-wrapper {
  padding: 0 20px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
}

.link-gold {
  color: var(--primary-gold);
  font-size: 13px;
  text-decoration: none;
  font-weight: 600;
  cursor: pointer;
}

.tx-item {
  background: var(--surface-color);
  border: 1px solid var(--surface-border);
  border-radius: 14px;
  padding: 14px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.tx-store {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 3px;
}

.tx-time {
  font-size: 12px;
  color: var(--text-muted);
}

.tx-amount {
  font-size: 14px;
  font-weight: 700;
  color: var(--primary-gold);
}

/* Camera Scan Viewfinder Screen */
.camera-container {
  margin: 16px 20px;
  background: #000;
  height: 330px;
  border-radius: 20px;
  position: relative;
  border: 2px dashed var(--primary-gold);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 24px;
  overflow: hidden;
}

.scanner-line {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-gold);
  box-shadow: 0 0 10px var(--primary-gold);
  animation: scanMove 2.2s infinite ease-in-out;
}

@keyframes scanMove {
  0% { top: 5%; }
  50% { top: 95%; }
  100% { top: 5%; }
}

.cam-inst {
  font-size: 16px;
  font-weight: 700;
  margin-top: 12px;
}

.cam-sub {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 6px;
  max-width: 250px;
}

.branding-banner {
  margin: 10px 20px 6px;
  padding: 10px 14px;
  background: var(--surface-color);
  border: 1px solid var(--surface-border);
  border-radius: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Financial Summary & Charts */
.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 16px 20px;
}

.summary-card {
  background: var(--surface-color);
  border: 1px solid var(--surface-border);
  padding: 14px;
  border-radius: 14px;
}

.summary-card.highlight {
  grid-column: span 2;
  border-color: var(--primary-gold);
  background: var(--card-bg);
}

.summary-title {
  font-size: 12px;
  color: var(--text-muted);
}

.summary-val {
  font-size: 18px;
  font-weight: 800;
  margin-top: 4px;
}

.chart-card {
  margin: 0 20px;
  background: var(--surface-color);
  border: 1px solid var(--surface-border);
  border-radius: 16px;
  padding: 18px;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 120px;
  margin-top: 18px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--surface-border);
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  flex: 1;
}

.bar {
  width: 22px;
  background: linear-gradient(to top, #6e5512, var(--primary-gold));
  border-radius: 6px 6px 0 0;
  transition: height 0.4s ease;
}

.bar-label {
  font-size: 11px;
  color: var(--text-muted);
}

/* Form & QR Screen */
.form-group {
  margin: 0 20px 14px;
}

.form-label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 6px;
  color: var(--text-muted);
}

.form-input {
  width: 100%;
  padding: 14px 16px;
  background: var(--surface-color);
  border: 1px solid var(--surface-border);
  border-radius: 12px;
  color: var(--text-main);
  font-size: 14px;
  outline: none;
}

.form-input:focus {
  border-color: var(--primary-gold);
}

.qr-box {
  margin: 20px auto;
  width: 210px;
  height: 210px;
  background: #FFFFFF;
  border-radius: 16px;
  padding: 12px;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 0 24px var(--gold-glow);
}

.qr-box svg {
  width: 100%;
  height: 100%;
}

/* Bottom Navigation Bar */
.bottom-nav {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70px;
  background: var(--header-bg);
  backdrop-filter: blur(12px);
  border-top: 1px solid var(--surface-border);
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 100;
}

.nav-item {
  background: none;
  border: none;
  color: var(--text-muted);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  width: 25%;
  transition: color 0.2s;
}

.nav-item.active {
  color: var(--primary-gold);
}

.nav-item svg {
  width: 20px;
  height: 20px;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
}

.primary-btn {
  width: calc(100% - 40px);
  margin: 14px 20px 6px;
  background: linear-gradient(135deg, var(--primary-gold), #967417);
  border: none;
  color: #000;
  font-weight: 700;
  padding: 15px;
  border-radius: 12px;
  font-size: 14px;
  cursor: pointer;
  letter-spacing: 0.5px;
}
